# GitHub personal access token — needs repo scope (read discussions + write contents)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Anthropic API key — for parsing comments with Claude
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# GitHub repo (defaults match dadmanual)
GITHUB_OWNER=jonschumann
GITHUB_REPO=dadmanual

# Path to CORRECTIONS.md inside the repo
CORRECTIONS_PATH=CORRECTIONS.md

# How often to poll GitHub for new comments (minutes)
POLL_INTERVAL_MINS=10

# Port the server listens on
PORT=3001
